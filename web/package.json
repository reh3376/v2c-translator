{
  "name": "v2c-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3009",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3009",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check-links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-links.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dark-art": "node scripts/dark-art.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
