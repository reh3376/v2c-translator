# The other arrangement: the career site's Caddy with a plain reverse_proxy added and its
# Content-Security-Policy left site-wide.
#
# Caddy's `header` with a value replaces the upstream header, so the app's own policy
# never reaches the browser and the site's is the only one in force. This file exists so
# the rig can show that, and show whether the page still works under it, rather than
# leaving it as an argument between two policies on a page.
#
# Keep it in step with Caddyfile. The only difference is the matcher on the policy.

{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), midi=(), sync-xhr=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com https://api.github.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://api.github.com https://api.pwnedpasswords.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /v2c* {
		reverse_proxy v2c:3009 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		respond "the rest of the career site" 200
	}
}
